  "scripts": {
    "test": "vitest run",
    "test:invariants": "vitest run tests/invariants.test.ts tests/golden-svg.test.ts",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/boardplot-typecheck.tsbuildinfo",
    "docs:build": "tsx scripts/generate-reference.mjs",
    "generate:font-metrics": "node scripts/build-font-metrics.mjs",
    "check:font-metrics": "node scripts/build-font-metrics.mjs --check",
    "build": "tsup && npm run build:types",
    "build:types": "node node_modules/typescript-7/bin/tsc --emitDeclarationOnly --declarationMap false -p tsconfig.build.json && node scripts/generate-chart-entries.mjs --declarations",
    "build:debug": "tsup --sourcemap && npm run build:types",
    "prepack": "npm run build",
    "smoke:package": "node scripts/package-smoke.mjs",
    "check:scorecard": "tsx scripts/layout-scorecard.mjs",
    "smoke:next": "node scripts/next-smoke.mjs",
    "generate:chart-entries": "node scripts/generate-chart-entries.mjs",
    "check:chart-entries": "node scripts/generate-chart-entries.mjs --check",
    "generate:choropleth-fixtures": "node scripts/generate-choropleth-fixtures.mjs",
    "check:choropleth-fixtures": "node scripts/generate-choropleth-fixtures.mjs --check",
    "check:plugin-version": "node scripts/plugin-version.mjs --check",
    "version": "node scripts/plugin-version.mjs --stage",
    "eval:tokens": "tsx evals/tokens.ts",
    "gallery": "node scripts/gallery.mjs",
    "check:ci": "node scripts/check-manual.mjs && node scripts/check-doc-anchors.mjs && npm run check:font-metrics && npm run check:chart-entries && npm run check:choropleth-fixtures && npm run check:plugin-version && npm run eval:tokens",
    "explorer": "tsx scripts/explorer/build.mjs"
  },
