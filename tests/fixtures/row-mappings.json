{
  "waterfall": {
    "spec": { "type": "waterfall", "options": { "title": "Changes from opening to closing", "format": "1.0" } },
    "columns": { "label": "item", "value": "amount", "type": "kind" },
    "rows": [
      { "item": "Opening", "amount": 100, "kind": "total", "unused": "a" },
      { "item": "Change", "amount": 20, "kind": "delta" },
      { "item": "Subtotal", "amount": 120, "kind": "subtotal" },
      { "item": "Change", "amount": -5, "kind": "delta" },
      { "item": "Closing", "amount": 115, "kind": "total" }
    ],
    "data": { "items": [
      { "id": "row-1", "label": "Opening", "value": 100, "type": "total" },
      { "id": "row-2", "label": "Change", "value": 20, "type": "delta" },
      { "id": "row-3", "label": "Subtotal", "value": 120, "type": "subtotal" },
      { "id": "row-4", "label": "Change", "value": -5, "type": "delta" },
      { "id": "row-5", "label": "Closing", "value": 115, "type": "total" }
    ] }
  },
  "scatter": {
    "spec": { "type": "scatter", "data": { "groups": [{ "id": "East", "label": "East team", "colorRole": "highlight" }] }, "options": { "title": "Output against effort", "axisTitles": { "x": "Effort", "y": "Output" }, "sizeLegend": { "label": "Volume" } } },
    "columns": { "x": "effort", "y": "output", "size": "volume", "label": "item", "group": "team" },
    "rows": [
      { "effort": 2.5, "output": 8, "volume": 12, "item": "Example", "team": "East", "unused": "a" },
      { "effort": 5, "output": 15, "volume": 20, "item": "Example", "team": "West" },
      { "effort": 4, "output": 10, "volume": 8, "item": "Third", "team": "East" }
    ],
    "data": {
      "points": [
        { "id": "row-1", "x": 2.5, "y": 8, "size": 12, "label": "Example", "group": "East" },
        { "id": "row-2", "x": 5, "y": 15, "size": 20, "label": "Example", "group": "West" },
        { "id": "row-3", "x": 4, "y": 10, "size": 8, "label": "Third", "group": "East" }
      ],
      "groups": [{ "id": "East", "label": "East team", "colorRole": "highlight" }, { "id": "West" }]
    }
  },
  "table": {
    "spec": { "type": "table", "options": { "title": "Revenue by region" }, "data": {
      "columns": [
        { "id": "region", "kind": "rowLabel", "label": "Region" },
        { "id": "revenue", "kind": "value", "label": "Revenue", "format": "1,234.5" },
        { "id": "plan", "kind": "value", "label": "Plan", "format": "1,234.5" },
        { "id": "vsPlan", "kind": "computed", "label": "vs plan", "calc": { "op": "percentDelta", "a": "revenue", "b": "plan" }, "format": "+1.2%" },
        { "id": "status", "kind": "status", "label": "Status" },
        { "id": "note", "kind": "text", "label": "Note" }
      ],
      "rows": [{ "id": "T", "role": "total", "totalPolicy": "source" }, { "id": "X", "label": "Template only" }]
    } },
    "columns": { "label": "name", "id": "code" },
    "rows": [
      { "code": "S", "name": "South", "revenue": 90.5, "plan": 100, "status": "at-risk", "note": "Late orders", "unused": "a" },
      { "code": "N", "name": "North", "revenue": 120, "plan": 100, "status": "on-track", "note": "Ahead", "unused": "b" },
      { "code": "T", "name": "Total", "revenue": 210.5, "plan": 200, "status": null, "note": "All regions", "unused": "c" }
    ],
    "data": { "rows": [
      { "id": "S", "label": "South", "cells": { "revenue": 90.5, "plan": 100, "status": "at-risk", "note": "Late orders" } },
      { "id": "N", "label": "North", "cells": { "revenue": 120, "plan": 100, "status": "on-track", "note": "Ahead" } },
      { "id": "T", "role": "total", "totalPolicy": "source", "label": "Total", "cells": { "revenue": 210.5, "plan": 200, "status": null, "note": "All regions" } }
    ] }
  },
  "histogram": {
    "spec": { "type": "histogram", "options": { "title": "Lead time in days" } },
    "columns": { "value": "days" },
    "rows": [
      { "days": 3, "unused": "a" }, { "days": 5.5, "unused": "b" }, { "days": 4, "unused": "c" }, { "days": 8, "unused": "d" },
      { "days": 2.5, "unused": "e" }, { "days": 6, "unused": "f" }, { "days": 4.5, "unused": "g" }, { "days": 12, "unused": "h" }
    ],
    "data": { "observations": [3, 5.5, 4, 8, 2.5, 6, 4.5, 12] }
  },
  "box": {
    "spec": { "type": "box", "options": { "title": "Lead time by team" }, "data": { "groups": [{ "id": "East", "label": "East team" }] } },
    "columns": { "category": "team", "value": "days", "categoryLabel": "name" },
    "rows": [
      { "team": "West", "name": "West team", "days": 4, "unused": "a" },
      { "team": "East", "name": null, "days": 3.5, "unused": "b" },
      { "team": "West", "name": "West team", "days": 6, "unused": "c" },
      { "team": "East", "name": null, "days": 5, "unused": "d" },
      { "team": "West", "name": null, "days": 7.5, "unused": "e" },
      { "team": "East", "name": null, "days": 2, "unused": "f" },
      { "team": "West", "name": "West team", "days": 9, "unused": "g" },
      { "team": "East", "name": null, "days": 4, "unused": "h" },
      { "team": "West", "name": "West team", "days": 5, "unused": "i" },
      { "team": "East", "name": null, "days": 6.5, "unused": "j" }
    ],
    "data": { "groups": [
      { "id": "West", "label": "West team", "observations": [4, 6, 7.5, 9, 5] },
      { "id": "East", "label": "East team", "observations": [3.5, 5, 2, 4, 6.5] }
    ] }
  }
}
